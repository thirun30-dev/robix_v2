<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ===================================================== -->
    <!-- STANDARD INERTIAL MACROS FOR ROBIX V2                -->
    <!-- Suitable for 4-wheel-drive robot model               -->
    <!-- ===================================================== -->


    <!-- ===================================================== -->
    <!-- BOX INERTIA                                           -->
    <!-- Used for chassis, battery enclosure, electronics etc. -->
    <!-- ===================================================== -->

    <xacro:macro name="inertial_box" params="mass x y z *origin">

        <inertial>

            <xacro:insert_block name="origin"/>

            <mass value="${mass}"/>

            <inertia
                ixx="${(1.0/12.0) * mass * (y*y + z*z)}"
                ixy="0.0"
                ixz="0.0"

                iyy="${(1.0/12.0) * mass * (x*x + z*z)}"
                iyz="0.0"

                izz="${(1.0/12.0) * mass * (x*x + y*y)}"
            />

        </inertial>

    </xacro:macro>


    <!-- ===================================================== -->
    <!-- CYLINDER INERTIA                                      -->
    <!-- Used for all 4 wheels                                 -->
    <!-- Cylinder axis is assumed to be along local Z-axis     -->
    <!-- ===================================================== -->

    <xacro:macro name="inertial_cylinder"
                 params="mass length radius *origin">

        <inertial>

            <xacro:insert_block name="origin"/>

            <mass value="${mass}"/>

            <inertia
                ixx="${(1.0/12.0) * mass *
                      (3.0*radius*radius + length*length)}"

                ixy="0.0"
                ixz="0.0"

                iyy="${(1.0/12.0) * mass *
                      (3.0*radius*radius + length*length)}"

                iyz="0.0"

                izz="${(1.0/2.0) * mass *
                      radius*radius}"
            />

        </inertial>

    </xacro:macro>


    <!-- ===================================================== -->
    <!-- SPHERE INERTIA                                        -->
    <!-- Optional: useful for caster / sensor models           -->
    <!-- ===================================================== -->

    <xacro:macro name="inertial_sphere"
                 params="mass radius *origin">

        <inertial>

            <xacro:insert_block name="origin"/>

            <mass value="${mass}"/>

            <inertia
                ixx="${(2.0/5.0) * mass * radius*radius}"
                ixy="0.0"
                ixz="0.0"

                iyy="${(2.0/5.0) * mass * radius*radius}"
                iyz="0.0"

                izz="${(2.0/5.0) * mass * radius*radius}"
            />

        </inertial>

    </xacro:macro>


</robot>
